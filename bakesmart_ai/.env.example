BAKESMART_AI_HOST=0.0.0.0
BAKESMART_AI_PORT=8000
BAKESMART_AI_LOG_LEVEL=INFO
BAKESMART_AI_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# BakeSmart core AI is local-only. Do not add hosted AI provider keys here.
# Venue vision, cake segmentation, recommendation ranking, scale/calibration,
# and scene planning must run from BakeSmart-owned local code/checkpoints.
BAKESMART_LOCAL_ONLY_AI=1
